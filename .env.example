# ===== Slack App の値 =====
# api.slack.com/apps > 対象アプリ > Basic Information から取得
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# ===== デプロイ先 =====
# デプロイ先のURL（末尾スラッシュなし）例: https://slack-status-signal.onrender.com
BASE_URL=

# 外部cron（cron-job.org等）から /trigger を叩く際に使う合言葉。適当な長いランダム文字列にする
# （例: `openssl rand -hex 24` の出力）。未設定だと管理URLは一切使えません。
TRIGGER_SECRET=change-me-to-a-long-random-string

PORT=3000

# ===== データ保存（Upstash Redis）=====
# 必須。未設定だとメンバー登録・ON/OFF・DM送信のすべてが動きません。
# https://upstash.com でRedisを作成し、詳細画面の REST API の値を貼る
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===== メンバー設定 =====
# ここに書いたメールアドレスの人だけ登録できる（カンマ区切り）
# 初回起動時の初期値としてのみ使われ、以降は /admin/members 画面で追加・削除する
ALLOWED_EMAILS=mitsuhiro.yoshida@yappli.co.jp

# 管理者のメールアドレス（カンマ区切り）。この人のDMにだけ「Bot管理用リンク」が表示される。
# 空にすると、管理リンクは誰のDMにも表示されない（管理はブックマークしたURLから行う）
ADMIN_EMAILS=mitsuhiro.yoshida@yappli.co.jp

# ===== 稼働条件 =====
# ある期間だけBotを動かしたい場合に設定（Asia/Tokyo基準、YYYY-MM-DD）。空欄なら期間制限なし
BOT_START_DATE=
BOT_END_DATE=

# 土日・日本の祝日はDMをスキップする（true / false）
SKIP_WEEKENDS_AND_HOLIDAYS=true

# 祝日APIが取得できず、保存済みキャッシュも無いときの挙動
#   send = 平日として送信する（デフォルト） / skip = 念のため送信しない
HOLIDAY_UNKNOWN_MODE=send

# サーバー内蔵cronを使う（常時起動できる環境のみ。Render無料枠では外部cronを使うのでfalse）
ENABLE_INTERNAL_CRON=false
